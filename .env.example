POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=neocortex
POSTGRES_PASSWORD=neocortex
POSTGRES_DATABASE=neocortex

NEOCORTEX_TRANSPORT=http
NEOCORTEX_SERVER_HOST=127.0.0.1
NEOCORTEX_SERVER_PORT=8000
NEOCORTEX_AUTH_MODE=none
NEOCORTEX_MOCK_DB=false

NEOCORTEX_DEV_TOKEN=tui-dev
NEOCORTEX_DEV_USER_ID=dev-user

NEOCORTEX_GOOGLE_CLIENT_ID=
NEOCORTEX_GOOGLE_CLIENT_SECRET=
NEOCORTEX_OAUTH_BASE_URL=http://localhost:8000

# Per-agent inference. Thinking effort: false | minimal | low | medium | high | xhigh.
# "false" turns reasoning off entirely; for Qwen models the request then carries
# reasoning_effort=none and chat_template_kwargs.enable_thinking=false.
NEOCORTEX_ONTOLOGY_THINKING_EFFORT=medium
NEOCORTEX_EXTRACTOR_THINKING_EFFORT=low
NEOCORTEX_LIBRARIAN_THINKING_EFFORT=low
NEOCORTEX_DOMAIN_CLASSIFIER_THINKING_EFFORT=medium

# Per-agent output ceilings, applied to Qwen models only (every output token is
# wall time on a local endpoint). Hosted models keep the provider default.
NEOCORTEX_ONTOLOGY_MAX_TOKENS=600
NEOCORTEX_EXTRACTOR_MAX_TOKENS=2500
NEOCORTEX_LIBRARIAN_MAX_TOKENS=1500
NEOCORTEX_DOMAIN_CLASSIFIER_MAX_TOKENS=400
